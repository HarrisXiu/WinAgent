{
  "name": "winagent",
  "version": "0.5.0",
  "description": "Windows AI Agent（OpenAI 兼容 + 本地 Ollama，内置完整 Windows 工具集，支持 skills 与 MCP 挂载，LLM Wiki 知识库）",
  "author": "WinAgent",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "build:icon": "node scripts/build-icon.js",
    "plugin:build": "tsc -p dsh-plugin",
    "test:speech": "node scripts/test-speech.cjs",
    "test:models": "npm run plugin:build && node --test tests/models-fetch.test.cjs",
    "test:wiki": "npm run plugin:build && node --test tests/wiki-workspace.test.cjs",
    "test:wiki-ui": "npm run build && node scripts/test-wiki-ui.cjs",
    "test:workbench-ui": "npm run build && node scripts/test-workbench-ui.cjs",
    "test:output-limit": "npm run plugin:build && node --test tests/output-limit.test.cjs",
    "test:conversations": "npm run plugin:build && node --test tests/conversations.test.cjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "colord": "^2.9.3",
    "dsh-winagent": "file:./dsh-plugin",
    "highlight.js": "^11.9.0",
    "lucide-react": "^0.400.0",
    "marked": "^12.0.2",
    "pdfjs-dist": "4.10.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "png2icons": "^2.0.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.8"
  }
}
