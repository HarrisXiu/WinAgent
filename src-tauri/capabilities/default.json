{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "WinAgent 主窗口与知识库窗口的默认权限：核心 IPC/事件、对话框、文件系统、shell",
  "windows": ["main", "wiki"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:path:default",
    "core:resources:default",
    "dialog:default",
    "shell:default",
    "fs:default"
  ]
}
